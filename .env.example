# Backend base URL (no trailing slash). Dev default is http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Auth mode: "dev" uses POST /v1/auth/dev-login personas (backend AUTH_MODE=dev);
# "supabase" uses Supabase Google OAuth + TOTP MFA. If unset, supabase mode is used only
# when both VITE_SUPABASE_* values below are set, otherwise dev mode.
VITE_AUTH_MODE=dev

# Supabase (public anon key only; never commit a service-role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
