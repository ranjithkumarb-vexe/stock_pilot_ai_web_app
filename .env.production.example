# Production build template for Vercel (FE-12). These are PUBLIC build-time values (VITE_* is inlined into the JS bundle):
# never put a secret here. Set the same names in Vercel -> Project -> Settings -> Environment Variables (Production), then
# redeploy: changing a value does nothing until the app is rebuilt.
#
# Backend origin: no trailing slash, https only. Must ALSO be listed in the connect-src of vercel.json
# (`npm run check:deploy` fails the build if it is not).
VITE_API_BASE_URL=https://stockpilot-api.onrender.com

# "supabase" = Google OAuth + TOTP MFA (production). Never "dev" in production: the backend refuses AUTH_MODE=dev
# when APP_ENV=prod, so the demo-persona sign-in would simply fail.
VITE_AUTH_MODE=supabase

# Supabase project -> Settings -> API: "Project URL" and the "anon" / publishable key. The service-role key must NEVER be
# used here (it would ship to every browser).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Optional: BUILD_SOURCEMAP=hidden writes source maps without the sourceMappingURL comment (default: no maps at all).
